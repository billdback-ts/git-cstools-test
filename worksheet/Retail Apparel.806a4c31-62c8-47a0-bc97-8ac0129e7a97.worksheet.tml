guid: 806a4c31-62c8-47a0-bc97-8ac0129e7a97
model:
  name: Retail Apparel
  description: The "Retail Apparel" worksheet provides a comprehensive overview of sales data for a retail clothing business. It captures detailed information about each transaction, including the location of the sale, the specific products sold, and the quantity purchased. Additionally, it includes geographical data and the date of each record, allowing for analysis of sales trends over time and across different regions. (AI generated)
  model_tables:
  - name: DIM_RETAPP_PRODUCTS
    fqn: 41aa7d50-5c4d-43eb-aa0c-ae4689e5976e
  - name: DIM_RETAPP_STORES
    fqn: b8a9cc93-99cd-4f59-94e6-f179c1dd1925
  - name: FACT_RETAPP_SALES
    fqn: d5d6f60d-993a-478d-ba03-d9d64e0a239e
    joins:
    - with: DIM_RETAPP_PRODUCTS
      referencing_join: C_DIM_RETAPP_PRODUCTS
    - with: DIM_RETAPP_STORES
      referencing_join: C_DIM_RETAPP_STORES
  columns:
  - name: Productid
    column_id: DIM_RETAPP_PRODUCTS::PRODUCTID
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
  - name: Productname
    column_id: DIM_RETAPP_PRODUCTS::PRODUCTNAME
    properties:
      column_type: ATTRIBUTE
  - name: Producttype
    column_id: DIM_RETAPP_PRODUCTS::PRODUCTTYPE
    properties:
      column_type: ATTRIBUTE
  - name: City
